{
  "name": "orchest-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Orchest, a skill-first agent runtime with a Rust core",
  "keywords": [
    "agent",
    "llm",
    "ai",
    "skills",
    "runtime",
    "napi-rs"
  ],
  "homepage": "https://github.com/jianantian/orchest/blob/main/docs/guide/sdk-typescript.md",
  "bugs": "https://github.com/jianantian/orchest/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianantian/orchest.git"
  },
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "main": "js/index.js",
  "types": "js/public.d.ts",
  "exports": {
    ".": {
      "types": "./js/public.d.ts",
      "require": "./js/index.js",
      "default": "./js/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "js/public.d.ts"
      ]
    }
  },
  "files": [
    "js/index.js",
    "js/index.d.ts",
    "js/load-native.js",
    "js/load-native.d.ts",
    "js/public.d.ts",
    "js/types.d.ts",
    "js/native.d.ts",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "napi": {
    "binaryName": "orchest_node",
    "packageName": "orchest-sdk",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --release --manifest-path crates/orchest-node/Cargo.toml --output-dir . --no-js --dts target/napi/index.d.ts",
    "pack:local": "npm run build:native && scripts/pack-node-sdk.sh target/npm-pack",
    "test": "node --test js/tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "orchest-sdk-darwin-arm64": "0.1.0",
    "orchest-sdk-linux-arm64-gnu": "0.1.0",
    "orchest-sdk-linux-x64-gnu": "0.1.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
