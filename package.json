{
  "name": "@orchest/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Orchest Agent Runtime",
  "type": "commonjs",
  "main": "js/index.js",
  "types": "js/index.d.ts",
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "require": "./js/index.js",
      "default": "./js/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "js/index.d.ts"
      ]
    }
  },
  "files": [
    "orchest_node.node",
    "js/index.js",
    "js/index.d.ts",
    "js/native.d.ts"
  ],
  "scripts": {
    "build:native": "cargo build -p orchest-node --release && node scripts/copy-node-addon.mjs",
    "pack:local": "npm run build:native && npm pack",
    "test": "node --test js/tests/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
