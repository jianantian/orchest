# Copy this file to the repository root as `.env`.
#
# The examples read `.env` from the repo root and do not overwrite variables
# already exported in your shell.

EXA_API_KEY=

# Use canonical provider model strings.
DEEP_RESEARCH_MODEL=anthropic/claude-sonnet-4-20250514
WEB_SEARCH_MODEL=openrouter/anthropic/claude-sonnet-4

# Set the provider keys for the configured models.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional.
ANTHROPIC_API_URL=
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=5
EXA_LIVECRAWL=0
DEEP_RESEARCH_MIN_CALLS=3
