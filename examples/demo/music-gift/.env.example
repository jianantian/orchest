# Music Gift environment variables.
#
# Copy to `.env` and fill in values, then export before running:
#   set -a && . ./.env && set +a
#   cargo run -p music-gift-demo

# ── Chat model (required) ──────────────────────────────────────────────────
MUSIC_GIFT_CHAT_MODEL=anthropic/claude-sonnet-4-6
MUSIC_GIFT_CHAT_API_KEY=

# ── Music generation provider (required) ───────────────────────────────────
# Provider: mureka, minimax, suno, or aliyun
MUSIC_GIFT_MUSIC_PROVIDER=mureka
MUSIC_GIFT_MUSIC_MODEL=mureka-9
MUSIC_GIFT_MUSIC_API_KEY=
# Optional: override endpoint
# MUSIC_GIFT_MUSIC_API_URL=https://api.mureka.ai

# ── Server ─────────────────────────────────────────────────────────────────
MUSIC_GIFT_PORT=3000
