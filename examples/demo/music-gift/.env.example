# Music Gift environment variables.
#
# Copy to `.env` and fill in values, then export before running:
#   set -a && . ./.env && set +a
#   cargo run -p music-gift-demo

# ── Chat model (required) ──────────────────────────────────────────────────
MUSIC_GIFT_CHAT_MODEL=elss/claude-sonnet-5
MUSIC_GIFT_CHAT_API_KEY=sk-your-elss-key

# ── Countdown HTML model (optional) ─────────────────────────────────────────
# The birthday countdown page is generated by a separate subagent; point it at
# a code-capable model for better HTML. Unset → falls back to the chat model.
# Only the model string is overridden — it shares the chat API key/URL, so it
# must be served by the same provider as MUSIC_GIFT_CHAT_MODEL.
# MUSIC_GIFT_COUNTDOWN_MODEL=elss/claude-sonnet-5
# Output budget for the countdown subagent. Unset → MUSIC_GIFT_CHAT_MAX_TOKENS,
# then a built-in default of 8192 (a full HTML+CSS+JS page needs the room).
# MUSIC_GIFT_COUNTDOWN_MAX_TOKENS=8192

# ── Music generation ────────────────────────────────────────────────────────
# Provider: suno (default), mureka, minimax, or aliyun
MUSIC_GIFT_MUSIC_PROVIDER=suno
MUSIC_GIFT_MUSIC_MODEL=V5_5
MUSIC_GIFT_MUSIC_API_KEY=
# MUSIC_GIFT_MUSIC_API_URL=https://api.sunoapi.org

# ── Proxy bypass ───────────────────────────────────────────────────────────
no_proxy=api.elss.ai,api.sunoapi.org

# ── Server ─────────────────────────────────────────────────────────────────
MUSIC_GIFT_PORT=3000

# ── Auth ───────────────────────────────────────────────────────────────────
# Required for all login flows:
BASE_URL=http://localhost:3000

# Magic link (Resend SMTP):
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxx
SMTP_FROM=Moment <noreply@your-domain.com>

# Google OAuth (https://console.cloud.google.com):
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/cb
