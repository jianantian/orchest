# Music Gift environment variables.
#
# Copy to `.env` and fill in values, then export before running:
#   set -a && . ./.env && set +a
#   cargo run -p music-gift-demo

# ── Chat model (required) ──────────────────────────────────────────────────
MUSIC_GIFT_CHAT_MODEL=elss/claude-sonnet-5
MUSIC_GIFT_CHAT_API_KEY=sk-your-elss-key
# Provider: suno (default), mureka, minimax, or aliyun
MUSIC_GIFT_MUSIC_PROVIDER=suno
MUSIC_GIFT_MUSIC_MODEL=V5_5
MUSIC_GIFT_MUSIC_API_KEY=
# MUSIC_GIFT_MUSIC_API_URL=https://api.sunoapi.org

# ── Proxy bypass (needed when system proxy is active) ──────────────────
# If your system has an HTTP proxy that can't handle API traffic,
# add the API hosts to no_proxy:
no_proxy=api.elss.ai,api.sunoapi.org

# ── Server ─────────────────────────────────────────────────────────────────
MUSIC_GIFT_PORT=3000
