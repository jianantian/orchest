# Music Gift environment variables.
#
# Copy to `.env` and fill in values, then export before running:
#   set -a && . ./.env && set +a
#   cargo run -p music-gift-demo

# ── Chat model (required) ──────────────────────────────────────────────────
# Option 1: Direct provider (e.g. Anthropic)
MUSIC_GIFT_CHAT_MODEL=anthropic/claude-sonnet-4-6
MUSIC_GIFT_CHAT_API_KEY=
#
# Option 2: Via Elss gateway (https://elss.ai) — a single key, two protocols.
# The protocol is selected in the model string: elss/<protocol>/<model>.
# Same Claude model, either protocol:
#   Messages (preserves prompt caching / thinking):
#     MUSIC_GIFT_CHAT_MODEL=elss/messages/claude-sonnet-5
#   Chat (OpenAI-compatible tool-use parity):
#     MUSIC_GIFT_CHAT_MODEL=elss/chat/gpt-4.1
#   MUSIC_GIFT_CHAT_API_KEY=sk-your-elss-key
# Protocol is also auto-detected without the segment (claude-* -> Messages,
# else Chat): elss/claude-sonnet-5, elss/gpt-4.1.
# The older provider-alias forms (elss/anthropic/…, elss/openai/…) remain valid.
# API_URL is optional (defaults to https://api.elss.ai); set it only to override.
# Provider: suno (default), mureka, minimax, or aliyun
MUSIC_GIFT_MUSIC_PROVIDER=suno
MUSIC_GIFT_MUSIC_MODEL=V5_5
MUSIC_GIFT_MUSIC_API_KEY=
# MUSIC_GIFT_MUSIC_API_URL=https://api.sunoapi.org

# ── Server ─────────────────────────────────────────────────────────────────
MUSIC_GIFT_PORT=3000
