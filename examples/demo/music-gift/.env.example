# Music Gift environment variables.
#
# Copy to `.env` and fill in values, then export before running:
#   set -a && . ./.env && set +a
#   cargo run -p music-gift-demo

# ── Chat model (required) ──────────────────────────────────────────────────
# Option 1: Direct provider (e.g. Anthropic)
MUSIC_GIFT_CHAT_MODEL=anthropic/claude-sonnet-4-6
MUSIC_GIFT_CHAT_API_KEY=
#
# Option 2: Via Elss gateway (https://elss.ai)
# Claude models use Anthropic protocol (x-api-key, Elss also accepts it):
#   MUSIC_GIFT_CHAT_MODEL=anthropic/claude-sonnet-5
#   MUSIC_GIFT_CHAT_API_KEY=sk-your-elss-key
#   MUSIC_GIFT_CHAT_API_URL=https://api.elss.ai/v1/messages
# Other models (GPT etc.) use OpenAI protocol (Bearer auth):
#   MUSIC_GIFT_CHAT_MODEL=openai/gpt-4.1
#   MUSIC_GIFT_CHAT_API_KEY=sk-your-elss-key
#   MUSIC_GIFT_CHAT_API_URL=https://api.elss.ai/v1/chat/completions
# Provider: suno (default), mureka, minimax, or aliyun
MUSIC_GIFT_MUSIC_PROVIDER=suno
MUSIC_GIFT_MUSIC_MODEL=V5_5
MUSIC_GIFT_MUSIC_API_KEY=
# MUSIC_GIFT_MUSIC_API_URL=https://api.sunoapi.org

# ── Server ─────────────────────────────────────────────────────────────────
MUSIC_GIFT_PORT=3000
