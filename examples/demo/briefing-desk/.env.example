# Briefing Desk environment variables.
#
# Copy to `.env` and fill in values, then export them before running:
#   set -a && . ./.env && set +a
#   cargo run -p briefing-desk-demo -- run --materials fixtures/research \
#     --question "..." --output /tmp/brief.md
#
# The binary reads these via std::env::var at runtime; it does NOT load .env
# itself (no dotenv dependency). You must export them into the environment.

# ── Chat model (required) ──────────────────────────────────────────────────
# Set BRIEFING_DESK_CHAT_MODEL to a provider/model string to use a real LLM.
# Without this variable, the demo errors out with a clear message.
#
# Model string format: "provider/model", e.g.:
#   anthropic/claude-sonnet-4-6
#   deepseek/deepseek-v4-flash
#   openrouter/anthropic/claude-sonnet-4
#   volcengine/doubao-pro-32k
#
# If the model is vision-capable (e.g. claude-sonnet), it is also used for
# describe_image and the review_report sub-agent. No separate vision/reviewer
# configuration is needed.
BRIEFING_DESK_CHAT_MODEL=anthropic/claude-sonnet-4-6

# API key. If unset, the provider's default key env var is used (e.g.
# ANTHROPIC_API_KEY for the anthropic provider).
BRIEFING_DESK_CHAT_API_KEY=

# Override the provider's default API endpoint (for proxies, gateways, etc.).
# BRIEFING_DESK_CHAT_API_URL=https://api.anthropic.com

# Override the default output token ceiling (default is provider-specific).
# BRIEFING_DESK_CHAT_MAX_TOKENS=4096

# ── ASR: real transcription instead of FakeAsr ─────────────────────────────
# Set all three to use a real ASR provider from orchest_provider::Registry.
# Leave all three unset/commented to use the deterministic FakeAsr (offline).
BRIEFING_DESK_ASR_PROVIDER=volcengine
BRIEFING_DESK_ASR_MODEL=
BRIEFING_DESK_ASR_API_KEY=

# ── TTS: real synthesis instead of FakeTts ─────────────────────────────────
# Set all three to use a real TTS provider. Leave unset to use FakeTts.
# Independent of ASR: you can run live ASR with fake TTS or vice versa.
BRIEFING_DESK_TTS_PROVIDER=volcengine
BRIEFING_DESK_TTS_MODEL=
BRIEFING_DESK_TTS_API_KEY=
